  "cards": [
    {
      "dot": "cyan",
      "title": "Ingress & Presentation",
      "items": [
        "Nginx terminates TLS and serves static UI bundles to desktop and mobile clients.",
        "Filament v5 + Livewire v4 render reactive Member, Tenant Admin, and System Admin panels.",
        "Reverb delivers instantaneous Livewire DOM and notification updates over WebSockets."
      ]
    },
    {
      "dot": "emerald",
      "title": "Accounting & Loan Domain",
      "items": [
        "Dual-entry ledger maintains real-time parity between Member and Master fund accounts.",
        "Accounting invariants strictly enforce zero pool drift across member deposit, disbursement, and cash-out.",
        "Loan calculator & lifecycle engines simulate amortization, grace cycles, and threshold milestones."
      ]
    },
    {
      "dot": "violet",
      "title": "Async Processing & Integrations",
      "items": [
        "Redis queues isolate heavy operations (delinquency audits, collection cycles, PDF exports).",
        "Scheduled workers run nightly invariant integrity checks and trigger automatic notifications.",
        "Bank transaction feeds ingest and match statement lines against uncleared ledger postings."
      ]
    },
    {
      "dot": "rose",
      "title": "Security & Multi-Tenancy",
      "items": [
        "Tenant context scoping isolates database queries and ledger transactions strictly per organization.",
        "Role-based authorization and 2FA protect administrative financial adjustments.",
        "Complete audit trail logs every state mutation and clearance action."
      ]
    }
  ]
