#!/usr/bin/env bash
# Run Pest/PHPUnit with a hard wall-clock timeout and kill hung runners.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Overall suite budget (seconds). Override with FF_TEST_TIMEOUT=…
TIMEOUT_SECS="${FF_TEST_TIMEOUT:-900}"
KILL_AFTER_SECS="${FF_TEST_KILL_AFTER:-30}"

cleanup() {
  # Kill orphaned pest/phpunit children if the timeout wrapper is interrupted.
  pkill -TERM -f 'vendor/pestphp/pest/bin/pest' 2>/dev/null || true
  pkill -TERM -f 'vendor/phpunit/phpunit/phpunit' 2>/dev/null || true
  sleep 1
  pkill -KILL -f 'vendor/pestphp/pest/bin/pest' 2>/dev/null || true
  pkill -KILL -f 'vendor/phpunit/phpunit/phpunit' 2>/dev/null || true
}
trap cleanup EXIT INT TERM

exec /usr/bin/timeout \
  --foreground \
  --kill-after="${KILL_AFTER_SECS}s" \
  "${TIMEOUT_SECS}s" \
  php artisan test "$@"
